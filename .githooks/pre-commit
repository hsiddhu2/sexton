#!/usr/bin/env bash
# Sexton pre-commit gates. Fails the commit if any gate fails.
set -euo pipefail
fail(){ echo "pre-commit: $1" >&2; exit 1; }
staged=$(git diff --cached --name-only --diff-filter=ACMR || true)

# 1. private/ must never be staged
echo "$staged" | grep -q '^private/' && fail "private/ files are staged. Unstage them."

# 2. .kiro must not be ignored
git check-ignore -q .kiro && fail ".kiro is ignored by .gitignore. Hackathon rules require it committed."

# 3. license present
[ -s LICENSE ] || fail "LICENSE missing."

# 4. no AI attribution trailers in staged files
for f in $staged; do
  [ -f "$f" ] || continue
  case "$f" in .githooks/*) continue;; esac
  grep -nEi 'co-authored-by:.*(claude|anthropic|kiro|copilot|openai)' "$f" && fail "AI co-author trailer found in $f."
done

# 5. secrets: simple patterns, the real scanner runs in CI
for f in $staged; do
  [ -f "$f" ] || continue
  case "$f" in *.md|*.txt|LICENSE|NOTICE) continue;; esac
  grep -nE '(AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|-----BEGIN (RSA|EC|OPENSSH) PRIVATE KEY-----)' "$f" && fail "possible secret in $f."
done

# 6. lint and typecheck when a workspace exists
if [ -f package.json ] && grep -q '"lint"' package.json; then npm run -s lint || fail "lint failed."; fi
if [ -f package.json ] && grep -q '"typecheck"' package.json; then npm run -s typecheck || fail "typecheck failed."; fi
echo "pre-commit: all gates passed"
