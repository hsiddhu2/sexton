{
  "name": "sexton-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Sexton finds the dependencies that will hurt you, proves it, and opens the pull request that fixes it.",
  "license": "Apache-2.0",
  "author": "Harpreet Singh Siddhu",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "scan:self": "node scripts/self-scan.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.10.2",
    "@types/semver": "7.8.0",
    "eslint": "10.15.0",
    "fast-check": "3.23.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  },
  "type": "module"
}
